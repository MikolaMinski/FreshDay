{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "npm",
      "script": "build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "preview",
      "type": "npm",
      "script": "preview",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "leadbot: build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/server/FreshDay.Server.slnx"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "leadbot: test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/server/FreshDay.Server.slnx"],
      "problemMatcher": "$msCompile",
      "group": "test"
    },
    {
      "label": "leadbot: run",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/server/src/FreshDay.LeadBot"],
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
