# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Токен бота от @BotFather
Telegram__BotToken=

# ID группы, куда присылать заявки (бот сам скажет его: добавьте бота в группу).
Telegram__Chats__0__Id=
# Если в группе включены темы — ID темы для заявок:
# Telegram__Chats__0__ThreadId=
# Вторая группа или личный чат (необязательно):
# Telegram__Chats__1__Id=

# Домен сервиса (A-запись должна указывать на этот сервер), например api.freshday.by
LEADBOT_DOMAIN=

# Адрес сайта и откуда разрешено отправлять форму
LeadBot__SiteUrl=https://mikolaminski.github.io/FreshDay
LeadBot__AllowedOrigins__0=https://mikolaminski.github.io
# Когда подключите свой домен сайта:
# LeadBot__SiteUrl=https://freshday.by
# LeadBot__AllowedOrigins__1=https://freshday.by
# LeadBot__AllowedOrigins__2=https://www.freshday.by
