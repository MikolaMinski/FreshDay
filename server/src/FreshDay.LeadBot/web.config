<?xml version="1.0" encoding="utf-8"?>
<!--
  Для IIS (Windows-хостинг, Plesk). dotnet publish дописывает сюда запуск приложения (aspNetCore).
  existingResponse="PassThrough": IIS не подменяет ответы сервиса (400/429/502/503 с JSON)
  своими страницами ошибок — иначе теряются заголовки CORS и браузер видит «blocked by CORS».
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <httpErrors existingResponse="PassThrough" />
    </system.webServer>
  </location>
</configuration>
