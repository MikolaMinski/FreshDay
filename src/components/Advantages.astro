---
import { Image } from 'astro:assets';
import { advantages } from '@/data/content';
import { photo } from '@/data/gallery';
import Icon, { type IconName } from './Icon.astro';

const icons: IconName[] = ['chef', 'plate', 'receipt', 'team'];
---

<section class="section section--tint adv">
  <div class="container adv__grid">
    <div class="adv__media" data-reveal="zoom">
      <Image
        src={photo('svadba-zal-zelenye-skaterti')}
        alt="Зал, подготовленный нами к свадебному банкету"
        widths={[480, 720, 960]}
        sizes="(max-width: 900px) 100vw, 45vw"
        layout="none"
      />
      <div class="adv__quote">
        <p>«Мы отвечаем за всё, что на столе и вокруг него. Вы — за хорошее настроение гостей».</p>
      </div>
    </div>
    <div>
      <div class="section-head">
        <span class="eyebrow">Почему мы</span>
        <h2>Кейтеринг, которому доверяют важные даты</h2>
        <p>
          Всё делаем сами — от закупки продуктов до уборки площадки. Поэтому отвечаем за результат
          полностью.
        </p>
      </div>
      <ul class="adv__list" data-stagger>
        {advantages.map((a, i) => (
          <li data-reveal>
            <span class="adv__icon">
              <Icon name={icons[i] ?? 'check'} />
            </span>
            <div>
              <h3>{a.title}</h3>
              <p>{a.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .adv__grid {
    display: grid;
    grid-template-columns: 0.9fr 1fr;
    gap: clamp(2rem, 1rem + 5vw, 6rem);
    align-items: center;
  }
  .adv__media {
    position: relative;
  }
  .adv__media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .adv__quote {
    position: absolute;
    right: -1.5rem;
    bottom: 2rem;
    max-width: 18rem;
    padding: 1.5rem;
    background: var(--c-primary);
    color: var(--c-primary-ink);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-style: italic;
    line-height: 1.3;
  }
  .adv__list {
    display: grid;
    gap: 1.75rem;
    list-style: none;
    padding: 0;
  }
  .adv__list li {
    display: flex;
    gap: 1.25rem;
  }
  .adv__icon {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--c-accent-soft);
    color: var(--c-primary);
  }
  .adv__list h3 {
    font-family: var(--font-body);
    font-size: var(--fs-lg);
    font-weight: 700;
    margin-bottom: 0.3rem;
  }
  .adv__list p {
    color: var(--c-muted);
  }
  @media (max-width: 900px) {
    .adv__grid {
      grid-template-columns: 1fr;
    }
    .adv__quote {
      right: 1rem;
      left: 1rem;
      max-width: none;
    }
  }
</style>
