---
import { url } from '@/lib/url';

interface Props {
  items: { name: string; href: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="Хлебные крошки" class="crumbs">
  <ol>
    {items.map((item, i) => (
      <li>
        {i < items.length - 1 ? (
          <a href={url(item.href)}>{item.name}</a>
        ) : (
          <span aria-current="page">{item.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    font-size: var(--fs-xs);
    opacity: 0.85;
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 0.4rem;
    opacity: 0.5;
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs a:hover {
    text-decoration: underline;
  }
</style>
