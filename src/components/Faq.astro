---
/** Вопросы-ответы на нативных <details>: работают без JS, доступны, индексируются. */
interface Props {
  items: ReadonlyArray<{ q: string; a: string }>;
  title?: string;
}
const { items, title = 'Частые вопросы' } = Astro.props;
---

<section class="section">
  <div class="container faq">
    <div class="section-head">
      <span class="eyebrow">FAQ</span>
      <h2>{title}</h2>
    </div>
    <div class="faq__list" data-stagger>
      {items.map((item, i) => (
        <details name="faq" open={i === 0} data-reveal>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 2rem 4rem;
    align-items: start;
  }
  .faq__list {
    display: grid;
    gap: 0.75rem;
  }
  details {
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  details::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 0.45s var(--ease-out),
      content-visibility 0.45s allow-discrete;
  }
  details[open]::details-content {
    block-size: auto;
  }
  summary {
    position: relative;
    padding: 1.25rem 3.5rem 1.25rem 1.5rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '';
    position: absolute;
    right: 1.5rem;
    top: 50%;
    width: 0.8rem;
    height: 0.8rem;
    margin-top: -0.55rem;
    border-right: 2px solid var(--c-accent);
    border-bottom: 2px solid var(--c-accent);
    rotate: 45deg;
    transition: rotate 0.35s var(--ease-out);
  }
  details[open] summary::after {
    rotate: 225deg;
    margin-top: -0.15rem;
  }
  details p {
    padding: 0 1.5rem 1.5rem;
    color: var(--c-muted);
  }
  @media (max-width: 900px) {
    .faq {
      grid-template-columns: 1fr;
    }
  }
</style>
