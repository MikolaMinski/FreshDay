---
/**
 * Галерея: masonry-сетка, фильтр по категориям, просмотр в полноэкранном окне
 * (нативный <dialog>), листание клавиатурой и свайпом.
 */
import { Image, getImage } from 'astro:assets';
import { CATEGORIES, type GalleryItem } from '@/data/gallery';

interface Props {
  items: GalleryItem[];
  filters?: boolean;
  id?: string;
}
const { items, filters = false, id = 'gallery' } = Astro.props;

const prepared = await Promise.all(
  items.map(async (item) => {
    const full = await getImage({ src: item.src, width: 1280, format: 'webp', quality: 82 });
    return { ...item, full: full.src };
  }),
);
const usedCats = Object.entries(CATEGORIES).filter(([key]) =>
  items.some((i) => i.category === key),
);
---

<div class="gallery" id={id} data-gallery>
  {filters && (
    <div class="gallery__filters" role="toolbar" aria-label="Фильтр по типу мероприятия">
      <button type="button" data-filter="all" aria-pressed="true">
        Все <sup>{items.length}</sup>
      </button>
      {usedCats.map(([key, label]) => (
        <button type="button" data-filter={key} aria-pressed="false">
          {label} <sup>{items.filter((i) => i.category === key).length}</sup>
        </button>
      ))}
    </div>
  )}

  <ul class="gallery__grid">
    {prepared.map((item, i) => (
      <li data-cat={item.category} style={`view-transition-name: g-${id}-${i}`}>
        <button
          type="button"
          class="gallery__item"
          data-full={item.full}
          data-alt={item.alt}
          aria-label={`Открыть фото: ${item.alt}`}
        >
          <Image
            src={item.src}
            alt={item.alt}
            widths={[360, 540, 720]}
            sizes="(max-width: 600px) 50vw, (max-width: 1000px) 33vw, 25vw"
            layout="none"
          />
          <span class="gallery__cap">{CATEGORIES[item.category]}</span>
        </button>
      </li>
    ))}
  </ul>

  <dialog class="lightbox" aria-label="Просмотр фото">
    <figure>
      <img src="" alt="" />
      <figcaption></figcaption>
    </figure>
    <button type="button" class="lightbox__btn lightbox__close" data-close aria-label="Закрыть">
      ✕
    </button>
    <button
      type="button"
      class="lightbox__btn lightbox__prev"
      data-prev
      aria-label="Предыдущее фото"
    >
      ‹
    </button>
    <button
      type="button"
      class="lightbox__btn lightbox__next"
      data-next
      aria-label="Следующее фото"
    >
      ›
    </button>
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const cells = [...root.querySelectorAll<HTMLLIElement>('.gallery__grid > li')];
    const dialog = root.querySelector('dialog')!;
    const img = dialog.querySelector('img')!;
    const cap = dialog.querySelector('figcaption')!;
    let current = 0;

    // Фильтр с плавной перестановкой через View Transitions API
    const apply = (cat: string) => {
      cells.forEach((li) => (li.hidden = cat !== 'all' && li.dataset.cat !== cat));
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === cat)));
    };
    buttons.forEach((btn) =>
      btn.addEventListener('click', () => {
        const cat = btn.dataset.filter ?? 'all';
        if (document.startViewTransition) document.startViewTransition(() => apply(cat));
        else apply(cat);
      }),
    );

    // Лайтбокс
    const visible = () => cells.filter((li) => !li.hidden);
    const show = (index: number) => {
      const list = visible();
      current = (index + list.length) % list.length;
      const btn = list[current]!.querySelector<HTMLButtonElement>('button')!;
      img.src = btn.dataset.full!;
      img.alt = btn.dataset.alt!;
      cap.textContent = `${btn.dataset.alt} · ${current + 1} / ${list.length}`;
    };
    cells.forEach((li) =>
      li.querySelector('button')!.addEventListener('click', () => {
        show(visible().indexOf(li));
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-prev]')!.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-next]')!.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
    let startX = 0;
    dialog.addEventListener('touchstart', (e) => (startX = e.touches[0]!.clientX), {
      passive: true,
    });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0]!.clientX - startX;
      if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
    });
  });
</script>

<style>
  .gallery__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .gallery__filters button {
    padding: 0.55rem 1.1rem;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    background: var(--c-surface);
    font-size: var(--fs-sm);
    font-weight: 600;
    cursor: pointer;
    transition:
      background 0.25s,
      color 0.25s,
      border-color 0.25s;
  }
  .gallery__filters button:hover {
    border-color: var(--c-primary);
  }
  .gallery__filters button[aria-pressed='true'] {
    background: var(--c-primary);
    border-color: var(--c-primary);
    color: var(--c-primary-ink);
  }
  .gallery__filters sup {
    font-size: 0.7em;
    opacity: 0.6;
  }
  .gallery__grid {
    columns: 4 14rem;
    column-gap: 1rem;
    list-style: none;
    padding: 0;
  }
  .gallery__grid li {
    break-inside: avoid;
    margin-bottom: 1rem;
  }
  .gallery__item {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
    cursor: zoom-in;
    background: var(--c-line);
  }
  .gallery__item :global(img) {
    width: 100%;
    height: auto;
    transition:
      scale 0.9s var(--ease-out),
      filter 0.5s;
  }
  .gallery__item:hover :global(img) {
    scale: 1.06;
    filter: brightness(0.85);
  }
  .gallery__cap {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    background: oklch(100% 0 0 / 0.9);
    color: var(--c-ink);
    font-size: var(--fs-xs);
    font-weight: 600;
    opacity: 0;
    translate: 0 0.5rem;
    transition:
      opacity 0.35s,
      translate 0.35s var(--ease-out);
  }
  .gallery__item:hover .gallery__cap,
  .gallery__item:focus-visible .gallery__cap {
    opacity: 1;
    translate: 0 0;
  }

  /* Лайтбокс */
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    padding: 0;
    border: 0;
    background: oklch(12% 0.01 160 / 0.96);
    color: #fff;
    opacity: 0;
    transition:
      opacity 0.3s,
      display 0.3s allow-discrete,
      overlay 0.3s allow-discrete;
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
    opacity: 1;
  }
  @starting-style {
    .lightbox[open] {
      opacity: 0;
    }
  }
  .lightbox figure {
    display: grid;
    gap: 0.75rem;
    justify-items: center;
    padding: 4rem 1rem 2rem;
  }
  .lightbox img {
    max-width: min(92vw, 1280px);
    max-height: 80dvh;
    width: auto;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }
  .lightbox figcaption {
    font-size: var(--fs-sm);
    opacity: 0.8;
    text-align: center;
  }
  .lightbox__btn {
    position: fixed;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid oklch(100% 0 0 / 0.3);
    border-radius: 50%;
    background: oklch(0% 0 0 / 0.3);
    color: #fff;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }
  .lightbox__btn:hover {
    background: var(--c-accent);
    color: var(--c-dark);
  }
  .lightbox__close {
    top: 1rem;
    right: 1rem;
    font-size: 1.1rem;
  }
  .lightbox__prev,
  .lightbox__next {
    top: 50%;
    translate: 0 -50%;
  }
  .lightbox__prev {
    left: 1rem;
  }
  .lightbox__next {
    right: 1rem;
  }
  @media (max-width: 600px) {
    .gallery__grid {
      columns: 2;
      column-gap: 0.6rem;
    }
    .gallery__grid li {
      margin-bottom: 0.6rem;
    }
    .lightbox__prev,
    .lightbox__next {
      top: auto;
      bottom: 1rem;
      translate: none;
    }
  }
</style>
