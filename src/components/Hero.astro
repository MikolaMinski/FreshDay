---
import { url } from '@/lib/url';
import { Image } from 'astro:assets';
import { SITE } from '@/config/site';
import { photo } from '@/data/gallery';
import Icon from './Icon.astro';

const images = [
  { src: photo('kanape-i-tartaletki'), alt: 'Канапе и тарталетки для фуршета' },
  { src: photo('servirovka-svechi-dub'), alt: 'Свадебная сервировка стола со свечами' },
  { src: photo('vyezdnoj-banket-v-lesu'), alt: 'Выездной банкет в беседке в лесу' },
];
const words = ['Кейтеринг', 'в Минске'];
---

<section class="hero">
  <div class="container hero__grid">
    <div class="hero__text">
      <p class="eyebrow hero__in" style="--d: 0">
        Фуршеты · банкеты · кофе-брейки
      </p>
      <h1 class="hero__title">
        {words.map((w, i) => (
          <span class="hero__word" style={`--d: ${i + 1}`}>
            {w}
          </span>
        ))}
        <em class="hero__word" style="--d: 3">
          под ключ
        </em>
      </h1>
      <p class="hero__lead hero__in" style="--d: 4">
        Готовим на своей кухне, привозим посуду, сервируем и обслуживаем гостей — от
        уютного ужина на 10 человек до свадьбы на 300. Вы просто наслаждаетесь праздником.
      </p>
      <div class="hero__actions hero__in" style="--d: 5">
        <a href="#zayavka" class="btn btn--accent">
          Оставить заявку <Icon name="arrow" />
        </a>
        <a href={url('/uslugi/')} class="btn btn--ghost">
          Услуги и цены
        </a>
      </div>
    </div>

    <div class="hero__collage" aria-hidden="false">
      {images.map((img, i) => (
        <figure class={`hero__photo hero__photo--${i + 1}`}>
          <Image
            src={img.src}
            alt={img.alt}
            widths={[320, 480, 640]}
            sizes="(max-width: 900px) 45vw, 22vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            layout="none"
          />
        </figure>
      ))}
      <div class="hero__badge">
        <strong>
          {SITE.stats[1]?.value}
          {SITE.stats[1]?.suffix}
        </strong>
        <span>
          мероприятий
          <br />в Минске и районе
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(7rem, 6rem + 6vw, 11rem) clamp(4rem, 3rem + 4vw, 7rem);
    background:
      radial-gradient(60rem 40rem at 85% 10%, oklch(42% 0.09 145 / 0.9), transparent 60%),
      radial-gradient(40rem 30rem at 0% 100%, oklch(70% 0.15 127 / 0.22), transparent 60%),
      var(--c-dark);
    color: var(--c-primary-ink);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
  }
  .hero__title {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.28em;
    margin-block: 1.25rem 1.5rem;
    font-size: var(--fs-3xl);
    font-weight: 600;
    line-height: 0.98;
  }
  .hero__title em {
    width: 100%;
    color: var(--c-accent);
    font-style: italic;
  }
  .hero__lead {
    max-width: 34rem;
    font-size: var(--fs-lg);
    color: oklch(88% 0.02 150);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  /* Появление при загрузке */
  .hero__word,
  .hero__in {
    animation: hero-in 1.1s var(--ease-out) both;
    animation-delay: calc(var(--d) * 110ms + 100ms);
  }
  .hero__word {
    display: inline-block;
  }
  @keyframes hero-in {
    from {
      /* 0.01, а не 0: так заголовок сразу учитывается браузером как LCP */
      opacity: 0.01;
      translate: 0 0.6em;
      filter: blur(8px);
    }
  }

  /* Коллаж из фото */
  .hero__collage {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-template-rows: repeat(8, clamp(2.5rem, 1.5rem + 3vw, 4.5rem));
  }
  .hero__photo {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    animation: photo-in 1.4s var(--ease-out) both;
  }
  .hero__photo :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: kenburns 18s ease-in-out infinite alternate;
  }
  .hero__photo--1 {
    grid-area: 1 / 1 / 7 / 4;
    animation-delay: 0.3s;
  }
  .hero__photo--2 {
    grid-area: 2 / 4 / 9 / 7;
    animation-delay: 0.5s;
  }
  .hero__photo--3 {
    grid-area: 6 / 2 / 9 / 4;
    z-index: 1;
    outline: 6px solid var(--c-dark);
    animation-delay: 0.7s;
  }
  .hero__photo--2 :global(img) {
    animation-delay: -6s;
  }
  @keyframes photo-in {
    from {
      opacity: 0;
      translate: 0 3rem;
      scale: 0.95;
    }
  }
  @keyframes kenburns {
    to {
      scale: 1.12;
    }
  }
  .hero__badge {
    position: absolute;
    left: -1.5rem;
    top: 55%;
    z-index: 2;
    display: grid;
    gap: 0.2rem;
    padding: 1rem 1.25rem;
    background: var(--c-accent);
    color: var(--c-dark);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    font-size: var(--fs-xs);
    line-height: 1.3;
    animation:
      photo-in 1.2s 1s var(--ease-out) both,
      float 6s 2.2s ease-in-out infinite;
  }
  .hero__badge strong {
    font-family: var(--font-display);
    font-size: 2.2rem;
    line-height: 1;
  }
  @keyframes float {
    50% {
      translate: 0 -10px;
    }
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__collage {
      grid-template-rows: repeat(8, clamp(2.2rem, 8vw, 3.5rem));
    }
    .hero__badge {
      left: auto;
      right: 0.5rem;
      top: auto;
      bottom: -1rem;
    }
  }
</style>
