---
/**
 * Логотип: эмблема (src/assets/brand/logo-emblem.png) + название из настроек.
 * Чтобы заменить эмблему — положите новый PNG с прозрачным фоном под тем же именем.
 */
import { Image } from 'astro:assets';
import emblem from '@/assets/brand/logo-emblem.png';
import { SITE } from '@/config/site';
---

<span class="logo">
  <Image
    class="logo__mark"
    src={emblem}
    alt=""
    width={56}
    height={56}
    loading="eager"
    layout="fixed"
  />
  <span class="logo__text">
    <span class="logo__name">{SITE.name}</span>
    <span class="logo__tag">{SITE.tagline}</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }
  .logo :global(.logo__mark) {
    width: 3.1rem;
    height: 3.1rem;
    flex-shrink: 0;
    filter: drop-shadow(0 2px 6px oklch(0% 0 0 / 0.18));
    transition: rotate 0.6s var(--ease-out);
  }
  a:hover .logo :global(.logo__mark) {
    rotate: -10deg;
  }
  .logo__text {
    display: grid;
    gap: 0.25rem;
    line-height: 1;
  }
  .logo__name {
    font-family: var(--font-body);
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .logo__tag {
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.7;
  }
</style>
