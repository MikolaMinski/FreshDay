---
/** Первый экран внутренних страниц: крошки, H1, подзаголовок, опционально фото. */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  title: string;
  lead?: string;
  eyebrow?: string;
  crumbs: { name: string; href: string }[];
  image?: ImageMetadata;
  imageAlt?: string;
}
const { title, lead, eyebrow, crumbs, image, imageAlt = '' } = Astro.props;
---

<section class:list={['phero', { 'phero--img': image }]}>
  <div class="container phero__grid">
    <div class="phero__text">
      <Breadcrumbs items={crumbs} />
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1>{title}</h1>
      {lead && <p class="phero__lead">{lead}</p>}
      <slot />
    </div>
    {image && (
      <div class="phero__media">
        <Image
          src={image}
          alt={imageAlt}
          widths={[480, 720, 960]}
          sizes="(max-width: 900px) 100vw, 40vw"
          loading="eager"
          fetchpriority="high"
          layout="none"
        />
      </div>
    )}
  </div>
</section>

<style>
  .phero {
    padding-block: clamp(3rem, 2rem + 4vw, 6rem);
    background:
      radial-gradient(50rem 30rem at 90% 0%, oklch(42% 0.07 158 / 0.9), transparent 60%),
      var(--c-dark);
    color: var(--c-primary-ink);
  }
  .phero__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  .phero--img .phero__grid {
    grid-template-columns: 1.2fr 1fr;
  }
  .phero__text {
    display: grid;
    gap: 1.25rem;
    animation: rise 1s var(--ease-out) both;
  }
  h1 {
    font-size: clamp(2.3rem, 1.5rem + 3vw, 4.4rem);
  }
  .phero__lead {
    max-width: 40rem;
    font-size: var(--fs-lg);
    color: oklch(86% 0.02 150);
  }
  .phero__media {
    animation: rise 1.2s 0.15s var(--ease-out) both;
  }
  .phero__media :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3.4;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
  }
  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 2rem;
    }
  }
  @media (max-width: 900px) {
    .phero--img .phero__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
