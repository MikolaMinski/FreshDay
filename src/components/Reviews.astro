---
/**
 * Блок отзывов на главной.
 * Отзывы — из src/data/reviews.ts; кнопка «Оставить отзыв» ведёт в профиль Google
 * (SITE.contacts.googleReview). Если нет ни отзывов, ни ссылки — блок не выводится.
 */
import { reviews } from '@/data/reviews';
import { SITE } from '@/config/site';
import Icon from '@/components/Icon.astro';

const reviewUrl = SITE.contacts.googleReview;
---

{(reviews.length > 0 || reviewUrl) && (
  <section class="section section--tint">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Отзывы</span>
        <h2>{reviews.length > 0 ? 'Что говорят клиенты' : 'Заказывали у нас?'}</h2>
        {reviews.length === 0 && (
          <p>
            Расскажите, как прошёл ваш праздник. Отзыв в Google займёт минуту и поможет другим
            выбрать кейтеринг.
          </p>
        )}
      </div>
      {reviews.length > 0 && (
        <div class="reviews" data-stagger>
          {reviews.map((r) => (
            <figure class="review" data-reveal>
              <blockquote>{r.text}</blockquote>
              <figcaption>
                <strong>{r.name}</strong>
                <span>{r.event}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      )}
      {reviewUrl && (
        <a
          class="btn btn--accent review-cta"
          href={reviewUrl}
          target="_blank"
          rel="noopener"
          data-goal="review"
        >
          <Icon name="star" /> Оставить отзыв в Google
        </a>
      )}
    </div>
  </section>
)}

<style>
  .reviews {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1.5rem;
  }
  .review {
    display: grid;
    gap: 1.25rem;
    padding: 2rem;
    background: var(--c-bg);
    border-radius: var(--radius);
  }
  .review blockquote {
    font-family: var(--font-display);
    font-size: var(--fs-lg);
    font-style: italic;
  }
  .review figcaption {
    display: grid;
    font-size: var(--fs-sm);
    color: var(--c-muted);
  }
  .review strong {
    color: var(--c-ink);
  }
  .reviews + .review-cta {
    margin-top: 2rem;
  }
</style>
