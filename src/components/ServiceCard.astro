---
import { url } from '@/lib/url';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  service: CollectionEntry<'services'>;
  headingLevel?: 'h2' | 'h3';
}
const { service, headingLevel: H = 'h3' } = Astro.props;
const { data } = service;
---

<article class="card" data-reveal>
  <a href={url(`/uslugi/${service.id}/`)} class="card__link">
    <div class="card__media">
      <Image
        src={data.cover}
        alt={data.coverAlt}
        widths={[400, 640, 800]}
        sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw"
        layout="none"
      />
      <span class="card__price">
        от {data.priceFrom} BYN <small>{data.priceUnit}</small>
      </span>
    </div>
    <div class="card__body">
      <span class="card__icon">
        <Icon name={data.icon} />
      </span>
      <H class="card__title">{data.name}</H>
      <p>{data.excerpt}</p>
      <span class="card__more">
        Подробнее и меню <Icon name="arrow" size={18} />
      </span>
    </div>
  </a>
</article>

<style>
  .card {
    container-type: inline-size;
  }
  .card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    text-decoration: none;
    transition:
      translate 0.5s var(--ease-out),
      box-shadow 0.5s var(--ease-out);
  }
  .card__link:hover {
    translate: 0 -6px;
    box-shadow: var(--shadow-lg);
  }
  .card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }
  .card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 1.2s var(--ease-out);
  }
  .card__link:hover .card__media :global(img) {
    scale: 1.08;
  }
  .card__price {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.4rem 0.9rem;
    background: var(--c-surface);
    border-radius: 999px;
    font-weight: 700;
    font-size: var(--fs-sm);
    color: var(--c-primary);
  }
  .card__price small {
    font-weight: 500;
    color: var(--c-muted);
  }
  .card__body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex: 1;
    padding: 2rem 1.5rem 1.5rem;
  }
  .card__icon {
    position: absolute;
    top: -1.6rem;
    right: 1.5rem;
    display: grid;
    place-items: center;
    width: 3.2rem;
    height: 3.2rem;
    background: var(--c-primary);
    color: var(--c-accent);
    border-radius: 50%;
    border: 3px solid var(--c-surface);
  }
  .card__title {
    font-size: var(--fs-xl);
  }
  .card__body p {
    color: var(--c-muted);
    font-size: var(--fs-sm);
  }
  .card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.5rem;
    font-weight: 700;
    font-size: var(--fs-sm);
    color: var(--c-primary);
  }
  .card__more :global(svg) {
    transition: translate 0.3s var(--ease-out);
  }
  .card__link:hover .card__more :global(svg) {
    translate: 4px 0;
  }
</style>
