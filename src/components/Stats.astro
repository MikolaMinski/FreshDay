---
import { SITE } from '@/config/site';
---

<section class="stats" aria-label="Цифры о нас">
  <div class="container stats__grid" data-stagger>
    {SITE.stats.map((s) => (
      <div class="stat" data-reveal>
        <p class="stat__value">
          <span data-count={s.value}>{s.value.toLocaleString('ru-RU')}</span>
          {s.suffix}
        </p>
        <p class="stat__label">{s.label}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .stats {
    padding-block: clamp(2.5rem, 2rem + 2vw, 4rem);
    border-bottom: 1px solid var(--c-line);
  }
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 2rem;
  }
  .stat {
    padding-left: 1.25rem;
    border-left: 2px solid var(--c-accent);
  }
  .stat__value {
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: 700;
    line-height: 1;
    color: var(--c-primary);
    font-variant-numeric: tabular-nums;
  }
  .stat__label {
    margin-top: 0.4rem;
    color: var(--c-muted);
    font-size: var(--fs-sm);
  }
</style>
