---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Страница не найдена" noindex>
  <section class="section">
    <div class="container nf">
      <p class="nf__code">404</p>
      <h1>Такого блюда нет в меню</h1>
      <p>Страница была удалена или переехала. Загляните на главную или в раздел услуг.</p>
      <div class="nf__actions">
        <a href="/" class="btn">
          На главную
        </a>
        <a href="/uslugi/" class="btn btn--ghost">
          Услуги
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    min-height: 55vh;
    align-content: center;
  }
  .nf__code {
    font-family: var(--font-display);
    font-size: clamp(6rem, 20vw, 12rem);
    line-height: 0.8;
    color: var(--c-accent);
  }
  h1 {
    font-size: var(--fs-2xl);
  }
  .nf__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
</style>
