---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import LeadForm from '@/components/LeadForm.astro';
import Icon from '@/components/Icon.astro';
import { SITE } from '@/config/site';

const { contacts } = SITE;
const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Контакты', href: '/kontakty/' },
];
const { lat, lng } = contacts.geo;
const mapSrc = `https://yandex.ru/map-widget/v1/?ll=${lng}%2C${lat}&z=15&pt=${lng}%2C${lat}%2Cpm2grm`;
---

<BaseLayout
  title="Контакты кейтеринга в Минске — телефон, адрес"
  description={`Заказать кейтеринг в Минске: ${contacts.phone}, Telegram, Viber. ${contacts.hours}. Работаем в Минске и по всей Беларуси.`}
  breadcrumbs={crumbs}
>
  <PageHero
    title="Контакты"
    lead="Ответим на вопросы, подберём меню и рассчитаем смету в течение суток."
    crumbs={crumbs}
  />

  <section class="section">
    <div class="container grid">
      <div class="info">
        <a class="info__item" href={`tel:${contacts.phoneHref}`}>
          <Icon name="phone" />
          <span>
            <small>Телефон</small>
            {contacts.phone}
          </span>
        </a>
        {contacts.phone2 && (
          <a class="info__item" href={`tel:${contacts.phone2Href}`}>
            <Icon name="phone" />
            <span>
              <small>Дополнительный телефон</small>
              {contacts.phone2}
            </span>
          </a>
        )}
        <a class="info__item" href={contacts.telegram} target="_blank" rel="noopener">
          <Icon name="telegram" />
          <span>
            <small>Telegram</small>Написать в Telegram
          </span>
        </a>
        <a class="info__item" href={contacts.viber}>
          <Icon name="viber" />
          <span>
            <small>Viber</small>Написать в Viber
          </span>
        </a>
        <a class="info__item" href={`mailto:${contacts.email}`}>
          <Icon name="mail" />
          <span>
            <small>Email</small>
            {contacts.email}
          </span>
        </a>
        <div class="info__item">
          <Icon name="pin" />
          <span>
            <small>Кухня и офис</small>г. {contacts.address.locality}, {contacts.address.street}
          </span>
        </div>
        <div class="info__item">
          <Icon name="clock" />
          <span>
            <small>Приём заявок</small>
            {contacts.hours}
          </span>
        </div>

        <div class="map" data-map={mapSrc}>
          <button type="button" class="btn btn--ghost">
            <Icon name="pin" /> Показать на карте
          </button>
        </div>
      </div>

      <div class="card" id="zayavka">
        <h2>Оставить заявку</h2>
        <p>Ответим в течение суток.</p>
        <LeadForm />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Карта грузится только по клику — не тормозит загрузку страницы
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      el.innerHTML = `<iframe src="${el.dataset.map}" title="Карта" loading="lazy" allowfullscreen></iframe>`;
    });
  });
</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .info {
    display: grid;
    gap: 0.75rem;
  }
  .info__item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    text-decoration: none;
    font-weight: 700;
    transition: border-color 0.25s;
  }
  a.info__item:hover {
    border-color: var(--c-primary);
  }
  .info__item > :global(svg) {
    flex-shrink: 0;
    color: var(--c-accent);
  }
  .info__item span {
    display: grid;
  }
  .info__item small {
    font-weight: 500;
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  .map {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    margin-top: 0.75rem;
    border-radius: var(--radius);
    overflow: hidden;
    background: repeating-linear-gradient(
      45deg,
      var(--c-accent-soft) 0 12px,
      var(--c-surface) 12px 24px
    );
    color: var(--c-primary);
  }
  .map :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .card {
    padding: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    background: var(--c-surface);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    scroll-margin-top: 6rem;
  }
  .card h2 {
    font-size: var(--fs-xl);
  }
  .card > p {
    margin-block: 0.5rem 1.5rem;
    color: var(--c-muted);
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
