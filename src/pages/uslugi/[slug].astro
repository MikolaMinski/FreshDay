---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Gallery from '@/components/Gallery.astro';
import ServicesGrid from '@/components/ServicesGrid.astro';
import OrderSection from '@/components/OrderSection.astro';
import Faq from '@/components/Faq.astro';
import Icon from '@/components/Icon.astro';
import { byCategory } from '@/data/gallery';
import { faqSchema, serviceSchema } from '@/lib/schema';
import { getImage } from 'astro:assets';

export async function getStaticPaths() {
  const services = await getCollection('services', ({ data }) => !data.draft);
  return services.map((service) => ({ params: { slug: service.id }, props: { service } }));
}

interface Props {
  service: CollectionEntry<'services'>;
}
const { service } = Astro.props;
const { data } = service;
const { Content } = await render(service);

const url = `/uslugi/${service.id}/`;
const crumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Услуги', href: '/uslugi/' },
  { name: data.name, href: url },
];
const photos = byCategory(data.galleryCategory);
const coverOg = await getImage({ src: data.cover, width: 1200, format: 'jpg' });
const schema = [
  serviceSchema({
    name: data.name,
    description: data.description,
    url,
    priceFrom: data.priceFrom,
    priceUnit: data.priceUnit,
    image: coverOg.src,
  }),
  ...(data.faq.length ? [faqSchema(data.faq)] : []),
];
---

<BaseLayout
  title={data.seoTitle}
  description={data.description}
  image={data.cover}
  imageAlt={data.coverAlt}
  breadcrumbs={crumbs}
  schema={schema}
>
  <PageHero
    title={data.h1}
    lead={data.excerpt}
    crumbs={crumbs}
    image={data.cover}
    imageAlt={data.coverAlt}
  >
    <div class="facts">
      <span>
        <strong>от {data.priceFrom} BYN</strong> {data.priceUnit}
      </span>
    </div>
    <div class="actions">
      <a href="#zayavka" class="btn btn--accent">
        Рассчитать стоимость <Icon name="arrow" />
      </a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container layout">
      <article class="prose">
        <Content />
      </article>
    </div>
  </section>

  {photos.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Фото</span>
          <h2>{data.name}: наши работы</h2>
        </div>
        <Gallery items={photos} id={service.id} />
      </div>
    </section>
  )}

  <OrderSection preset={service.id} title={`Сколько стоит ${data.name.toLowerCase()}?`} />
  {data.faq.length > 0 && <Faq items={data.faq} title={`Вопросы о формате «${data.name}»`} />}

  <section class="section section--tint">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Другие услуги</span>
        <h2>Может пригодиться</h2>
      </div>
      <ServicesGrid exclude={service.id} />
    </div>
  </section>
</BaseLayout>

<style>
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .facts span {
    padding: 0.5rem 1rem;
    border: 1px solid oklch(100% 0 0 / 0.2);
    border-radius: 999px;
    font-size: var(--fs-sm);
  }
  .facts strong {
    color: var(--c-accent);
  }
  .actions {
    margin-top: 0.5rem;
  }
  .layout {
    max-width: 50rem;
  }
</style>
